{
  "name": "@webhook-co/root",
  "version": "0.0.0",
  "private": true,
  "description": "Open-core webhook infrastructure \u2014 receive, inspect, replay-to-localhost, and reliably deliver webhooks.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev:db": "scripts/dev-db.sh",
    "dev:secrets": "node scripts/dev-secrets.mjs",
    "lint": "eslint . && pnpm run no-skipped-tests && pnpm run no-absolute-type-size && pnpm run no-unverified-claims && pnpm run tsconfig-boundary && pnpm run dal-gate-guard && pnpm run no-early-db-close && pnpm run cap-cron-sync-guard && pnpm run cron-dispatch-guard && pnpm run subrequest-budget-guard && pnpm run deploy-token-pr-guard && pnpm run hyperdrive-binding-guard && pnpm run tracing-safety-guard && pnpm run remote-db-test-guard && pnpm run workflow-timeout-guard && pnpm run overrides-guard && pnpm run adr-no-dup && pnpm run docs-nav-guard && pnpm run docs-structured-data-guard && pnpm run content-dup-guard && pnpm run readyz-coverage-guard && pnpm run deploy-env-parity-guard && pnpm run mcp-registry-guard && pnpm run trigger-copy-guard && pnpm run plugin-manifest-guard && pnpm run plugin-test-cases-guard && pnpm run kms-mode-guard && pnpm run dev-secrets-guard && pnpm run test:scripts",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=!@webhook-co/db",
    "test:db": "turbo run test --filter=@webhook-co/db && turbo run test:db --filter=@webhook-co/api --filter=@webhook-co/web --concurrency=1",
    "no-skipped-tests": "node scripts/no-skipped-tests.mjs",
    "no-absolute-type-size": "node scripts/no-absolute-type-size.mjs",
    "no-unverified-claims": "node scripts/no-unverified-claims.mjs",
    "tsconfig-boundary": "node scripts/tsconfig-boundary.mjs",
    "dal-gate-guard": "node scripts/dal-gate-guard.mjs",
    "cap-cron-sync-guard": "node scripts/cap-cron-sync-guard.mjs",
    "cron-dispatch-guard": "node scripts/cron-dispatch-guard.mjs",
    "subrequest-budget-guard": "node scripts/subrequest-budget-guard.mjs",
    "deploy-token-pr-guard": "node scripts/deploy-token-pr-guard.mjs",
    "hyperdrive-binding-guard": "node scripts/hyperdrive-cache-posture.mjs --lint",
    "tracing-safety-guard": "node scripts/tracing-safety-guard.mjs --lint",
    "remote-db-test-guard": "node scripts/remote-db-test-guard.mjs",
    "workflow-timeout-guard": "node scripts/workflow-timeout-guard.mjs",
    "overrides-guard": "node scripts/overrides-guard.mjs",
    "adr-no-dup": "node scripts/adr-no-dup.mjs",
    "docs-nav-guard": "node scripts/docs-nav-guard.mjs",
    "docs-structured-data-guard": "node scripts/docs-structured-data-guard.mjs",
    "content-dup-guard": "node scripts/content-dup-guard.mjs",
    "docs-live-structured-data-check": "node scripts/docs-live-structured-data-check.mjs",
    "gsc-ranking": "node scripts/gsc-provider-ranking.mjs",
    "gsc-coverage": "node scripts/gsc-index-coverage.mjs",
    "gsc-sitemap": "node scripts/gsc-sitemap-write.mjs",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "bing": "node scripts/bing-webmaster.mjs",
    "test:scripts": "node --test 'scripts/**/*.test.mjs' 'apps/*/scripts/**/*.test.mjs'",
    "prepare": "husky",
    "no-early-db-close": "node scripts/no-early-db-close.mjs",
    "readyz-coverage-guard": "node scripts/readyz-coverage-guard.mjs",
    "deploy-env-parity-guard": "node scripts/deploy-env-parity-guard.mjs",
    "mcp-registry-guard": "node scripts/mcp-registry-guard.mjs",
    "plugin-manifest-guard": "node scripts/plugin-manifest-guard.mjs",
    "plugin-test-cases-guard": "node scripts/plugin-test-cases-guard.mjs",
    "trigger-copy-guard": "node scripts/trigger-copy-guard.mjs",
    "dev-secrets-guard": "node scripts/dev-secrets.mjs --check",
    "kms-mode-guard": "node scripts/kms-mode-guard.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0",
    "yaml": "^2.9.0"
  }
}
