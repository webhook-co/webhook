{
  "name": "@webhook-co/root",
  "version": "0.0.0",
  "private": true,
  "description": "Open-core webhook infrastructure — receive, inspect, replay-to-localhost, and reliably deliver webhooks.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev:db": "scripts/dev-db.sh",
    "lint": "eslint . && pnpm run no-skipped-tests && pnpm run no-absolute-type-size && pnpm run no-unverified-claims && pnpm run tsconfig-boundary && pnpm run dal-gate-guard && pnpm run no-early-db-close && pnpm run cap-cron-sync-guard && pnpm run deploy-token-pr-guard && pnpm run hyperdrive-binding-guard && pnpm run tracing-safety-guard && pnpm run remote-db-test-guard && pnpm run adr-no-dup && pnpm run docs-nav-guard && pnpm run test:scripts",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=!@webhook-co/db",
    "test:db": "turbo run test --filter=@webhook-co/db && turbo run test:db --filter=@webhook-co/api --filter=@webhook-co/web --concurrency=1",
    "no-skipped-tests": "node scripts/no-skipped-tests.mjs",
    "no-absolute-type-size": "node scripts/no-absolute-type-size.mjs",
    "no-unverified-claims": "node scripts/no-unverified-claims.mjs",
    "tsconfig-boundary": "node scripts/tsconfig-boundary.mjs",
    "dal-gate-guard": "node scripts/dal-gate-guard.mjs",
    "cap-cron-sync-guard": "node scripts/cap-cron-sync-guard.mjs",
    "deploy-token-pr-guard": "node scripts/deploy-token-pr-guard.mjs",
    "hyperdrive-binding-guard": "node scripts/hyperdrive-cache-posture.mjs --lint",
    "tracing-safety-guard": "node scripts/tracing-safety-guard.mjs --lint",
    "remote-db-test-guard": "node scripts/remote-db-test-guard.mjs",
    "adr-no-dup": "node scripts/adr-no-dup.mjs",
    "docs-nav-guard": "node scripts/docs-nav-guard.mjs",
    "test:scripts": "node --test 'scripts/**/*.test.mjs' 'apps/*/scripts/**/*.test.mjs'",
    "prepare": "husky",
    "no-early-db-close": "node scripts/no-early-db-close.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@cloudflare/workers-types": "^5.20260715.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  }
}
