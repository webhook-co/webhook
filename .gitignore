# Dependencies
node_modules/

# Build output
dist/
build/
*.bundlebak
.turbo/
.wrangler/
.next/
.open-next/
out/
*.tsbuildinfo
# generated publishable npm package (packages/cli/scripts/npm-build.mjs)
packages/cli/npm/

# Per-environment wrangler deploy overlays: generated at deploy from the committed
# wrangler.jsonc + out-of-band ids/secret refs. Real ids never get committed (no-secrets).
wrangler.prod.jsonc
wrangler.*.prod.jsonc

# Next.js auto-generates this and flip-flops it between build/dev type paths.
# It lives under the already-ignored .next/ and is regenerated by `next dev`/`next build`.
next-env.d.ts

# Environment
.env
.env.*
# wrangler / OpenNext local dev secrets (next dev + `opennextjs-cloudflare preview`)
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*

# Logs
*.log

# Test coverage
coverage/

# Playwright + Lighthouse-CI output
test-results/
playwright-report/
.last-run.json
.lighthouseci/

# macOS
.DS_Store

# Scratch / temp files
.tmp-*

# Cursor plan files (local working artifacts, not committed; the rest of .cursor/ stays tracked)
.cursor/plans/

# Internal build plans / founder working docs — local-only, never committed.
# The public repo intentionally excludes internal planning (see AGENTS.md).
internal/

# Git worktrees created by coding agents (EnterWorktree). These are LOCAL scratch checkouts:
# committing them records phantom 160000 gitlink entries that break `git clone` for everyone else.
.claude/worktrees/

# Local prod-migration config (DATABASE_URL + expected host for unattended apply) — never commit
scripts/.prod-migrate.env

# Local dev Postgres cluster (scripts/dev-db.sh) — throwaway, never committed.
.dev-pg/

# Playwright (apps/web e2e)
apps/web/playwright/.tmp/
apps/web/playwright-report/
apps/web/test-results/
packages/db/db/schema.sql
