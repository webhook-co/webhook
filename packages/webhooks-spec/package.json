{
  "name": "@webhook-co/webhooks-spec",
  "version": "0.1.0",
  "description": "Verify an inbound webhook signature from 141 providers \u2014 Stripe, GitHub, Shopify, Slack, and every Standard Webhooks adopter \u2014 behind one adapter interface.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://webhook.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webhook-co/webhook.git",
    "directory": "packages/webhooks-spec"
  },
  "bugs": {
    "url": "https://github.com/webhook-co/webhook/issues"
  },
  "keywords": [
    "webhook",
    "webhooks",
    "signature",
    "signature-verification",
    "hmac",
    "standard-webhooks",
    "stripe",
    "github",
    "shopify",
    "slack",
    "security",
    "webhook.co"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.domcheck.json",
    "test": "vitest run --coverage",
    "smoke:packaged": "node ../../scripts/webhooks-spec-packaged-smoke.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "tsup": "^8.5.1"
  }
}
