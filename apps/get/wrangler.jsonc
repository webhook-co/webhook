{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webhook-get",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-15",
  // No Worker bindings, no secrets, no account/zone ids in the repo (wrangler reads the account from
  // CLOUDFLARE_ACCOUNT_ID). The Worker is content-free — it redirects to the installer rather than embedding
  // it — so the script upload isn't blocked by Cloudflare's API WAF (see src/router.ts).
  // Workers Logs + native tracing (S6 · ADR-0124), dashboard-only (no `destinations`; free during the beta).
  // SAFE to trace: get is a fixed-allowlist 302 shim whose path is only an asset name or semver tag and whose
  // redirect targets are canonical GitHub URLs — no token ever touches url.path/url.query. Enforced by
  // scripts/tracing-safety-guard.mjs. 5% head sampling: it is a trivial high-traffic redirect, so a small
  // sample is plenty and the other 95% pay nothing.
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.05 } },
  // Production lives only on the get.webhook.co custom domain. Unlike the wedge/auth Workers (whose routes
  // carry per-env zone ids via a deploy overlay), get is a single fixed PUBLIC hostname with no secrets, so
  // the custom domain is committed: `wrangler deploy` provisions + maintains it (DNS + cert) idempotently.
  "routes": [{ "pattern": "get.webhook.co", "custom_domain": true }],
  // No production *.workers.dev; per-version preview URLs stay on so a PR dry-run can validate the build.
  "workers_dev": false,
  "preview_urls": true,
}
