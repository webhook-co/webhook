# apps/api/dev.vars.example — COMMITTED reference, regenerated by `pnpm dev:secrets --examples`.
# Run `pnpm dev:secrets` to write the real apps/api/.dev.vars with generated values.
# Never paste a secret into this file: it is committed, and this repo is public.
# Key names and their meaning live in scripts/dev-secrets-manifest.mjs.

# GENERATED: HMAC pepper for API keys and ingest tokens. Read by api, engine, mcp, auth, web and packages/db — a mismatch makes a key minted by one surface unrecognisable to another.
CREDENTIAL_PEPPER=

# GENERATED: Hash-chain key for the tamper-evident audit log. Must match across every surface that appends or verifies.
AUDIT_CHAIN_HMAC_KEY=

# GENERATED: HMAC key for keyset pagination cursors. Read by api, engine and mcp; a cursor issued by one must verify in another.
CURSOR_KEY=

# LOCAL: off | test | live. `test` locally so the Stripe sandbox path is exercised; the client asserts the key prefix matches the mode.
BILLING_MODE=test

# EXTERNAL: Stripe TEST-mode key (sk_test_...). Without it billing is dark — every Stripe path no-ops rather than failing. See docs/local-billing-sandbox.md.
STRIPE_SECRET_KEY=

# EXTERNAL: Self-serve: `stripe listen --print-secret` prints your own. Without it the receiver returns 503 before reading the body.
STRIPE_WEBHOOK_SIGNING_SECRET=

# LOCAL: Meter event name. Empty means the metering flush is dark.
STRIPE_METER_EVENT_NAME=webhook_events
