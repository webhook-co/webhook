{
  "name": "@webhook-co/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "opennextjs-cloudflare build && opennextjs-cloudflare preview -- -c wrangler.dev.jsonc --port 3000 --ip 127.0.0.1 --inspector-port 4000",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:dry": "opennextjs-cloudflare build && wrangler deploy --dry-run",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.playwright.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.pg.config.ts",
    "test:e2e": "playwright test",
    "dev:fast": "next dev -p 3000"
  },
  "dependencies": {
    "@webhook-co/contract": "workspace:*",
    "@webhook-co/db": "workspace:*",
    "@webhook-co/shared": "workspace:*",
    "@webhook-co/ui": "workspace:*",
    "@webhook-co/webhooks-spec": "workspace:*",
    "geist": "^1.7.2",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3"
  }
}
