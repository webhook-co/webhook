{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The dashboard Worker (app.webhook.co), built by `@opennextjs/cloudflare` → `.open-next/worker.js`.
  // Unlike apps/www (a static assets-only Worker), this is a dynamic SSR Worker: it serves the OpenNext
  // server function + the build's static assets. `nodejs_compat` matches engine/api/mcp (the session
  // JWT + the Postgres driver that E6/E7 add need Node built-ins in workerd).
  "name": "webhook-web",
  "main": ".open-next/worker.js",
  // Recent date (matches apps/www); avoids the "update your compatibility_date" warning and enables the
  // current workerd features OpenNext relies on.
  "compatibility_date": "2026-06-15",
  // global_fetch_strictly_public: the canonical @opennextjs/cloudflare template ships this alongside
  // nodejs_compat — it makes a Worker fetch() to its OWN public hostname egress publicly instead of
  // looping back to the origin. Set now (a no-op for the bare runtime) so E6/E7's subrequests to
  // api./auth.webhook.co route correctly rather than short-circuiting.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
  },
  // Smart Placement — run the Worker NEXT TO THE DATABASE, not next to the user.
  //
  // The dashboard is not a static edge app: every page render is several Postgres round trips (the org-access
  // gate, then the page's own reads) over Hyperdrive to Neon, which lives in ONE region. Left at the default,
  // the Worker boots at the PoP nearest the user, so each of those round trips crosses the ocean and the
  // latency is multiplied by the number of queries. The only thing served from the edge would be the HTML —
  // which we cannot serve until the queries come back anyway.
  //
  // Smart Placement inverts that: Cloudflare observes where the subrequests actually go and relocates the
  // Worker there, so the many DB round trips become local and the single user round trip is the one that
  // crosses the distance. That is the right trade for a request whose cost is dominated by the database.
  //
  // It is a HINT, not a pin: Cloudflare only moves the Worker when it measures an improvement, and falls back
  // to default placement otherwise. Static assets are unaffected — they are served from the edge regardless.
  "placement": {
    "mode": "smart",
  },
  // Plain (non-secret) var. INGEST_BASE_URL is the cookieless ingest apex the dashboard's endpoint
  // create/rotate actions build the one-time ingest URL from (`${INGEST_BASE_URL}/<token>`), mirroring
  // apps/api. COMMITTED here (NOT deploy-injected): the prod overlay carries account ids/secrets/routes but
  // no `vars` and only PREPENDS to this config, so the value survives to prod. endpoint-mint validates it
  // fail-closed (a bad value throws before any mint, never returning a broken URL). Must match wbhk.my.
  "vars": {
    "INGEST_BASE_URL": "https://wbhk.my",
    // FREE_EVENT_CAP (S4.3b): the usage view shows a rowless org the cap it is enforced at. The
    // `<FREE_EVENT_CAP>` placeholder is DEPLOY-INJECTED by the overlay (optional FREE_EVENT_CAP GH var);
    // unset → "" → uncapped (fail-safe). Must equal the engine's FREE_EVENT_CAP. `next dev` → uncapped.
    "FREE_EVENT_CAP": "<FREE_EVENT_CAP>",
    // ASYNC_ORG_DELETION (#665) — DEPLOY-INJECTED (optional GH var); "true" routes org deletes through the
    // async requestOrgDeletion + webhook_reaper cron, else the synchronous deleteOrgWithAudit. Fail-safe OFF
    // until the reaper role + Hyperdrive are provisioned. `next dev` → unset → sync path.
    "ASYNC_ORG_DELETION": "<ASYNC_ORG_DELETION>",
    // Billing (S4.4b) — DEPLOY-INJECTED (optional GH vars); unset/"" → dark. BILLING_MODE off → the dashboard
    // Checkout/Portal actions no-op ("disabled"). STRIPE_PLANS is a JSON map of self-serve plan id →
    // { base, overage } Checkout line-item price IDS (never amounts); malformed/unset → Checkout disabled
    // (parseStripePlans fail-closed). Enterprise is contact-sales and has no entry.
    "BILLING_MODE": "<BILLING_MODE>",
    "STRIPE_PLANS": "<STRIPE_PLANS>",
    // The Billing Portal configuration id (bpc_…, S6c-ii) — pins the no-refund / at-period-end contract to a
    // versioned config. DEPLOY-INJECTED (optional STRIPE_PORTAL_CONFIGURATION_ID GH var); unset → "" → the
    // portal uses the account default (current behaviour).
    "STRIPE_PORTAL_CONFIGURATION_ID": "<STRIPE_PORTAL_CONFIGURATION_ID>",
  },
  // OpenNext emits the client/static assets under `.open-next/assets`; the worker serves them via this
  // binding (run-time-handled by the OpenNext server). No `account_id`/`routes` here — app.webhook.co is
  // bound at the zone per environment (mirrors apps/api + apps/www; no ids in the repo).
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // The credential dashboard reads/writes the org's keys+grants over the `webhook_app` Hyperdrive pool —
  // the SAME RLS-scoped pool apps/api's TENANT binding uses (cache-disabled; RLS via the session orgId is
  // the isolation backstop). Placeholder id per the no-secrets overlay convention (scripts/gen-wrangler-
  // prod.mjs token-replaces `<HYPERDRIVE_TENANT_ID>` at deploy from the GH repo var); the local string lets
  // `opennextjs-cloudflare build` + `wrangler dev`/preview run.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_TENANT",
      "id": "<HYPERDRIVE_TENANT_ID>",
      "localConnectionString": "postgres://webhook_app:postgres@127.0.0.1:5432/webhook_dev",
    },
  ],
  // The SHARED credential cache (the same KV_AUTHZ namespace api/mcp/engine read through). On revoke the
  // dashboard evicts the revoked key hash(es) via `cache.delete(credentialCacheKey(hash))` so a revoked key
  // stops authenticating immediately. Placeholder id (overlay token-replaces `<KV_AUTHZ_ID>` at deploy).
  "kv_namespaces": [
    {
      "binding": "KV_AUTHZ",
      "id": "<KV_AUTHZ_ID>",
    },
    // KV_CONFIG — the engine's INGEST-token cache (the SAME namespace by id, overlay-injected). The
    // dashboard binds it ONLY to EVICT a token's entry after the endpoint delete/rotate actions (ADR-0076,
    // mirrors api/mcp) so rotate's hard cutover stops the old URL immediately; never to read/write
    // principals. Eviction is best-effort (the deleted_at filter + 300s TTL self-heal are the durable stop).
    {
      "binding": "KV_CONFIG",
      "id": "<KV_CONFIG_ID>",
    },
  ],
  // The payloads bucket (shared with engine, which WRITES it). The dashboard only ever GETs from it — the
  // event payload-inspect view streams a captured event's stored body after an RLS metadata read (ADR-0015),
  // exactly like apps/api's events.getPayload. Read-only is a usage discipline (a scoped token is a future
  // hardening), not a binding mode. Miniflare provides a local R2 in `wrangler dev`; the deploy overlay maps
  // webhook-payloads-dev → webhook-payloads-prod.
  "r2_buckets": [
    {
      "binding": "R2_PAYLOADS",
      "bucket_name": "webhook-payloads-dev",
    },
    {
      // Durable store for the /api/provider-icon favicon proxy (provider logos). PUBLIC, non-tenant,
      // env-AGNOSTIC brand favicons — so it is ONE shared bucket (no dev/prod split, unlike the tenant
      // buckets): the deploy overlay leaves this name untouched (it maps only the `*-dev` tenant buckets),
      // which is correct here. Lets the proxy hit Google at most ONCE per domain, ever, and survive an
      // upstream outage. `wrangler dev` uses a local miniflare R2; prod binds the real bucket.
      "binding": "R2_PROVIDER_ICONS",
      "bucket_name": "webhook-provider-icons",
    },
    {
      // Uploaded user avatars (private, per-user, one webp object per user). Env-SPLIT like R2_PAYLOADS —
      // the `-dev` name here is rewritten to `-prod` by the deploy overlay (token map + placeholders in
      // gen-wrangler-prod.mjs), NOT env-agnostic like the provider-icons bucket.
      "binding": "R2_AVATARS",
      "bucket_name": "webhook-avatars-dev",
    },
  ],
  // AUTH_SESSION_EXCHANGE — the service binding to auth.'s SessionExchange WorkerEntrypoint, so /auth/callback
  // redeems the A-SX handoff ticket over a direct RPC instead of a public `POST /session/exchange` (the public
  // route stays as the fetch fallback). Deploy-injected (NOT committed) — like mcp's AUTH_ISSUER — because of
  // the deploy ORDERING: auth.'s SessionExchange entrypoint must be LIVE before this binding resolves, else CF
  // late-binds and web fails to start. With NO `services` block here, web starts fine with the binding simply
  // undefined and `exchangeTicket` transparently falls back to fetch (getSessionExchangeBinding → undefined).
  // The deploy overlay (scripts/gen-wrangler-prod.mjs) adds:
  //   "services": [{ "binding": "AUTH_SESSION_EXCHANGE", "service": "webhook-auth", "entrypoint": "SessionExchange" }]
  //
  // The runtime config the overlay injects at deploy (never committed here; resolved per-request via
  // getCloudflareContext() — see src/server/env.ts). E7 (the auth.→app. handoff) needs:
  //   SESSION_TOKEN_SECRET  Secrets Store — the HMAC key that signs the app. session cookie. Fails CLOSED
  //                         in prod if absent (env.ts never signs with a default); a 256-bit random secret.
  //   AUTH_BASE_URL         var — the auth. origin the /auth/callback backchannels /session/exchange against
  //                         (defaults to https://auth.webhook.co; set per env for preview/dev). Only used when
  //                         the AUTH_SESSION_EXCHANGE binding above is unbound (the fetch fallback path).
  //   secrets_store      CREDENTIAL_PEPPER + AUDIT_CHAIN_HMAC_KEY — the api-key HMAC pepper + the audit-chain
  //                      key (byte-identical to every surface), overlay-injected at deploy, never committed.
  // The production deploy (the OpenNext build→deploy job + the id/secret overlay) is coordinated with the
  // infra owner; this committed config supports `opennextjs-cloudflare build` + `wrangler dev`/preview.
}
