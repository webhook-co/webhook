{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webhook-engine",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // Non-secret runtime vars. FREE_EVENT_CAP is the Free tier's ONE-TIME LIFETIME event allowance (ADR-0004,
  // amended 2026-07-09 — counted over all time, never resets) for orgs without an explicit
  // org_limits row (S4.3 soft-cap) — a TIER FIGURE, so its VALUE is injected at deploy (the `<...>`
  // placeholder is replaced by the FREE_EVENT_CAP GH var; unset → "" → uncapped/no-Free-enforcement, the
  // fail-safe default). The literal placeholder is what `wrangler dev` sees locally (parses to uncapped).
  "vars": {
    "FREE_EVENT_CAP": "<FREE_EVENT_CAP>",
    // Billing (S4.4/S4.5) — all DEPLOY-INJECTED by the overlay from optional GH vars; unset → "" → dark.
    // BILLING_MODE off/"" → the meter-reporter cron no-ops (parseBillingMode fail-safes to off).
    // STRIPE_METER_EVENT_NAME → which Stripe Billing Meter the outbound usage reports count against.
    "BILLING_MODE": "<BILLING_MODE>",
    "STRIPE_METER_EVENT_NAME": "<STRIPE_METER_EVENT_NAME>",
    // STRIPE_METER_ID (WS1) → the Billing Meter id (mtr_…) the transport reconciler reads event summaries
    // from (summaries are addressed by meter id, not event_name). Unset → the transport cron is dark.
    "STRIPE_METER_ID": "<STRIPE_METER_ID>",
  },
  // Two Hyperdrive bindings (ADR-0002 / review finding C1):
  //   HYPERDRIVE_TENANT  — query caching DISABLED. ALL tenant-scoped reads use this.
  //     Hyperdrive's query cache is keyed on SQL+params and is blind to the RLS
  //     session GUC (app.current_org), so a cached tenant query could serve one
  //     org's rows to another. Tenant isolation must not rest on cache behavior.
  //   HYPERDRIVE_CACHED  — query caching ON. Only for non-tenant, cache-safe
  //     lookups; never for rows gated solely by RLS.
  // `id` is the per-environment Hyperdrive config id (set at deploy; not a secret).
  // `localConnectionString` is what `wrangler dev` uses, so local dev hits the
  // local Postgres directly (Hyperdrive doesn't run locally). Real ids + the
  // cache-disabled flag are configured per environment via `wrangler hyperdrive`.
  // localConnectionString carries a placeholder LOCAL password (`postgres`) because
  // Miniflare/wrangler's Hyperdrive validator requires `user:password@...`. It is a
  // local-dev value for a throwaway local Postgres only — never a real credential
  // (no-secrets); real connection details are injected per environment at deploy.
  //   HYPERDRIVE_ANCHOR  — query caching DISABLED. The WORM head-anchor cron's cross-org
  //     chain-head read, connecting as the webhook_anchor role (role-targeted SELECT policy +
  //     column grant). Caching off: the read is control-plane and must reflect live heads.
  //   HYPERDRIVE_AUTHN   — query caching DISABLED. The wbhk.my ingest cold path's
  //     org-discovery-by-token-hash, connecting as the webhook_authn role (role-targeted SELECT
  //     policy + column grant on endpoints). KV is the only invalidatable ingest cache; this
  //     binding's cache stays off so a paused/rotated endpoint is reflected on the next cold miss.
  //   HYPERDRIVE_INGEST  — query caching DISABLED. The single-statement `SELECT ingest_event(...)`
  //     insert, connecting as the dedicated webhook_ingest role (INSERT+SELECT on events only,
  //     statement_timeout=5s). RLS-gated writes must never rest on cache behavior.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_TENANT",
      "id": "<HYPERDRIVE_TENANT_ID>",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/webhook_dev",
    },
    {
      "binding": "HYPERDRIVE_CACHED",
      "id": "<HYPERDRIVE_CACHED_ID>",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/webhook_dev",
    },
    {
      "binding": "HYPERDRIVE_ANCHOR",
      "id": "<HYPERDRIVE_ANCHOR_ID>",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/webhook_dev",
    },
    {
      // HYPERDRIVE_RECONCILER — query caching DISABLED. The delivery reconciler cron's cross-org read of
      // due destinations, as webhook_reconciler (role-targeted SELECT policies + column grants). Same
      // posture as HYPERDRIVE_ANCHOR: no cache so a paused/rotated endpoint is reflected on the next pass.
      "binding": "HYPERDRIVE_RECONCILER",
      "id": "<HYPERDRIVE_RECONCILER_ID>",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/webhook_dev",
    },
    {
      // HYPERDRIVE_METER — query caching DISABLED. The metering-rollup cron's cross-org enumeration of orgs
      // with recent events / a stale-open usage day, as webhook_meter (role-targeted SELECT policies + column
      // grants scoped to the enumeration keys). Same posture as HYPERDRIVE_RECONCILER: no cache so a live
      // control-plane read reflects current activity. The per-org rollup + freeze use HYPERDRIVE_TENANT (app).
      "binding": "HYPERDRIVE_METER",
      "id": "<HYPERDRIVE_METER_ID>",
      "localConnectionString": "postgres://webhook_meter:postgres@127.0.0.1:5432/webhook_dev",
    },
    {
      "binding": "HYPERDRIVE_AUTHN",
      "id": "<HYPERDRIVE_AUTHN_ID>",
      "localConnectionString": "postgres://webhook_authn:postgres@127.0.0.1:5432/webhook_dev",
    },
    {
      "binding": "HYPERDRIVE_INGEST",
      "id": "<HYPERDRIVE_INGEST_ID>",
      "localConnectionString": "postgres://webhook_ingest:postgres@127.0.0.1:5432/webhook_dev",
    },
    // @gen-optional HYPERDRIVE_METER_AUDIT_ID
    // HYPERDRIVE_METER_AUDIT (S4.4d) — the F6 reconciliation oracle's webhook_meter_audit cross-org read
    // (recount events vs frozen usage). OPTIONAL: the overlay keeps this binding only when the
    // HYPERDRIVE_METER_AUDIT_ID GH var is set (provisioned), and strips it otherwise so the engine deploys
    // dark; the reconcile cron then skips (independent of BILLING_MODE). Caching off, like the other crons.
    {
      "binding": "HYPERDRIVE_METER_AUDIT",
      "id": "<HYPERDRIVE_METER_AUDIT_ID>",
      "localConnectionString": "postgres://webhook_meter_audit:postgres@127.0.0.1:5432/webhook_dev",
    },
    // @gen-end HYPERDRIVE_METER_AUDIT_ID
    // @gen-optional HYPERDRIVE_METER_TRANSPORT_AUDIT_ID
    // HYPERDRIVE_METER_TRANSPORT_AUDIT (WS1) — the webhook_meter_transport cross-org read (outbox `sent`
    // rows + org→customer map) for the Stripe transport reconciler. OPTIONAL: kept only when the
    // HYPERDRIVE_METER_TRANSPORT_AUDIT_ID GH var is set, stripped otherwise so the engine deploys dark; the
    // transport cron then skips. Caching off, like the other crons.
    {
      "binding": "HYPERDRIVE_METER_TRANSPORT_AUDIT",
      "id": "<HYPERDRIVE_METER_TRANSPORT_AUDIT_ID>",
      "localConnectionString": "postgres://webhook_meter_transport:postgres@127.0.0.1:5432/webhook_dev",
    },
    // @gen-end HYPERDRIVE_METER_TRANSPORT_AUDIT_ID
    // @gen-optional HYPERDRIVE_PURGE_ID
    // HYPERDRIVE_PURGE (data-lifecycle) — the webhook_purge cross-org read/advance of org_deletions jobs for
    // the R2 payload-body purge drain. OPTIONAL: kept only when the HYPERDRIVE_PURGE_ID GH var is set
    // (provisioned), stripped otherwise so the engine deploys dark; the purge cron then skips. The org
    // delete + durable job enqueue work regardless — only the R2 body-deletion waits on provisioning.
    // Caching off, like the other crons.
    {
      "binding": "HYPERDRIVE_PURGE",
      "id": "<HYPERDRIVE_PURGE_ID>",
      "localConnectionString": "postgres://webhook_purge:postgres@127.0.0.1:5432/webhook_dev",
    },
    // @gen-end HYPERDRIVE_PURGE_ID
    // @gen-optional HYPERDRIVE_RETENTION_ID
    // HYPERDRIVE_RETENTION (data-lifecycle slice 2.3) — the webhook_retention cross-org read+delete of aged
    // events for the per-plan retention prune. OPTIONAL: kept only when the HYPERDRIVE_RETENTION_ID GH var is
    // set (provisioned), stripped otherwise so the engine deploys dark; the prune cron then skips. Its
    // presence ALSO clamps the meter-reconcile lookback strictly inside the Free window (they activate
    // together). Caching off, like the other crons.
    {
      "binding": "HYPERDRIVE_RETENTION",
      "id": "<HYPERDRIVE_RETENTION_ID>",
      "localConnectionString": "postgres://webhook_retention:postgres@127.0.0.1:5432/webhook_dev",
    },
    // @gen-end HYPERDRIVE_RETENTION_ID
  ],
  // WORM head-anchor bucket (ADR-0004). Object retention is enforced by an R2 Bucket Lock
  // (R2 has Bucket Locks, NOT S3 Object Lock) on the `audit-anchors/` prefix — write-once, no
  // delete/overwrite for the retention period. The cron's credential is scoped to PUT only (no
  // delete rights). `bucket_name` is set per environment at deploy; the dev bucket uses a short
  // retention so test anchors don't lock for years.
  // R2_PAYLOADS holds one object per received event (key = payloadR2Key(org, endpoint, dedup)),
  // PUT durably before the metadata insert (durable-before-ACK, ADR-0013). bucket_name is set
  // per environment at deploy; EU-residency tenants get a jurisdiction-pinned bucket (ADR-0009).
  "r2_buckets": [
    {
      "binding": "R2_AUDIT_ANCHOR",
      "bucket_name": "webhook-audit-anchors-dev",
    },
    {
      "binding": "R2_PAYLOADS",
      "bucket_name": "webhook-payloads-dev",
    },
  ],
  // KV_CONFIG caches endpoint resolution on the ingest hot path (keyed by ingest-token hash).
  // KV is the ONLY ingest cache because it can be invalidated on pause/rotate/delete; the cold
  // path (webhook_authn) runs through the cache-disabled Hyperdrive binding. `id` is the
  // per-environment namespace id, set at deploy (not a secret); Miniflare provisions a local one.
  // KV_AUTHZ caches resolved api-key principals for the CLI listen-tunnel bearer chain (Slice 11b),
  // the same namespace + shape apps/api uses (keyed by api-key hash; invalidated on revoke). The
  // tunnel reuses the api. audience, so a key cached by either surface verifies at both.
  "kv_namespaces": [
    {
      "binding": "KV_CONFIG",
      "id": "<KV_CONFIG_ID>",
    },
    {
      "binding": "KV_AUTHZ",
      "id": "<KV_AUTHZ_ID>",
    },
  ],
  // Cloudflare Secrets Store bindings (`secrets_store_secrets`) — read in code via
  // `await readSecretBinding(env.X)`. The binding blocks (binding/store_id/secret_name) are injected
  // per environment at deploy (the overlay), NOT committed: real store ids stay out of the repo, and
  // tests inject plain-string `bindings` instead (readSecretBinding bridges both). The bindings:
  //   CREDENTIAL_PEPPER  base64 >=32 bytes — keys the ingest-token + api-key HMAC. ONE shared account
  //     secret across engine + api + mcp (byte-identical by construction).
  //   AUDIT_CHAIN_HMAC_KEY base64 >=32 bytes — the audit-chain MAC key (ADR-0004); shared trio.
  //   CURSOR_KEY         base64 32 bytes  — HMAC for opaque pagination/tunnel cursors; shared trio
  //     (cursors verify across surfaces, Slice 11b).
  //   AWS KMS (ADR-0007 / ADR-0009 day-one KMS) — the KEK custodian (AwsKmsProvider, GenerateDataKey/
  //     Decrypt over SigV4), engine-only. KMS_KEY_ARN + AWS_REGION identify the symmetric KEK;
  //     AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY are a least-privilege principal (kms:GenerateDataKey
  //     + kms:Decrypt on that ARN only). The KEK never leaves AWS; all four ride the Secrets Store.
  // Per-session hibernatable listen-tunnel DO (Slice 11b, ADR-0014): SQLite-backed (cursor + binding
  // in storage, survives hibernation). One DO per `wbhk listen` session, keyed by the server-minted
  // sessionId. The ONLY Durable Object in the wedge — ingest stays stateless (no DO on the hot path).
  "durable_objects": {
    "bindings": [
      { "name": "LISTEN_SESSION", "class_name": "ListenSession" },
      // Per-destination outbound delivery DO (S3 Slice 3): one per replay destination, owns its FIFO
      // queue + alarm-driven retry/backoff/dead-letter. SQLite-backed (stores only its binding + alarm;
      // the durable queue is the delivery_attempts table in Neon).
      { "name": "DELIVERY_DO", "class_name": "DeliveryDO" },
    ],
  },
  // A new migration TAG per added DO class (NEVER edit a shipped tag): v2 introduces DeliveryDO.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ListenSession"] },
    { "tag": "v2", "new_sqlite_classes": ["DeliveryDO"] },
  ],
  // Per-invocation subrequest limit (S5). Cloudflare removed the old 1,000-subrequest cap on 2026-02-11; the
  // paid default is now 10,000 subrequests/invocation. The HOURLY scheduled() invocation runs ~9 crons that
  // SHARE one budget, and the retention prune alone can issue up to 50 orgs × 40 batches × 3 ops = 6,000
  // binding subrequests, so the default would be too tight — raise it to 50,000 for wide margin. The bounded
  // prune loops (orgLimit × batchesPerOrg) remain the PRIMARY guard against runaway deletion; this ceiling is
  // only the platform backstop. NB: `limits` is worker-wide (no per-handler scope), so `cpu_ms` is left
  // UNSET on purpose — setting it would also lower the ingest fetch() path's default runaway CPU guard, and
  // the hourly cron already gets a 15-minute CPU budget by default (these crons are I/O-bound regardless).
  "limits": {
    "subrequests": 50000,
  },
  // Two cron triggers, each its OWN scheduled() invocation (switched on controller.cron, index.ts
  // scheduledCronPlan): the hourly head-anchor + rollup/reconcilers/purges + retention prune, and a 5-minute
  // soft-cap producer (S4) so a pause lands within minutes of an org crossing its event limit, not up to an
  // hour of billed over-cap ingest. Paid Cloudflare accounts allow up to 250 cron triggers, so two is ample.
  "triggers": {
    "crons": ["0 * * * *", "*/5 * * * *"],
  },
}
