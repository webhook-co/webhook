{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webhook-www",
  // The marketing site is a static export (apps/www `output: "export"` → ./out) served by Workers
  // Static Assets. A tiny `main` Worker runs AHEAD of the assets purely to record cookieless,
  // aggregate page-view analytics to Workers Analytics Engine; it serves every asset unchanged.
  "compatibility_date": "2026-06-15",
  "main": "./worker/index.ts",
  // Production is served only on the custom domain www.webhook.co (attached at the zone — NOT
  // committed here, mirroring apps/api + apps/mcp). Keep the production *.workers.dev route off;
  // per-version preview URLs stay on so CI can validate/preview a build without touching prod.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    // The Worker defers to static assets via this binding (env.ASSETS.fetch) — which applies
    // public/_headers (CSP, HSTS, caching) natively, so the pass-through preserves all headers.
    "binding": "ASSETS",
    // Run the Worker before serving assets so it can observe every request. It always calls
    // env.ASSETS.fetch and returns the asset untouched; only a successful HTML page view is logged
    // (see worker/index.ts + src/lib/analytics.ts). `true` avoids coupling a route glob-list to the
    // page manifest — the per-asset overhead is a non-blocking Analytics Engine write.
    "run_worker_first": true,
    // Next emits extensionless HTML; auto-trailing-slash matches `trailingSlash: false` + the
    // no-trailing-slash canonical/sitemap URLs without introducing a redirect loop.
    "html_handling": "auto-trailing-slash",
    // Serve out/404.html (emitted from app/not-found.tsx) — with a 404 status — for any unmatched path.
    "not_found_handling": "404-page",
  },
  // Cookieless page-view analytics: one Analytics Engine dataset (no database, no PII, auto-created).
  // The Worker writes path + referrer host + country + UTM per successful HTML view. Query it via the
  // Analytics Engine SQL API (see worker/README.md). Disclosed under GDPR Art. 13 on /privacy.
  "analytics_engine_datasets": [{ "binding": "WWW_ANALYTICS", "dataset": "webhook_www_analytics" }],
  // No `account_id` here (no-secrets: account/zone ids never land in the repo) — wrangler reads it
  // from CLOUDFLARE_ACCOUNT_ID at deploy. No `routes`/`custom_domain` either: www.webhook.co is
  // bound at the zone per environment. Caching + security headers + HSTS + CSP ship in
  // public/_headers (copied into ./out), which Workers Static Assets honors natively.
}
