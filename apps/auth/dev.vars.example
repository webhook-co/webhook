# apps/auth/dev.vars.example — COMMITTED reference, regenerated by `pnpm dev:secrets --examples`.
# Run `pnpm dev:secrets` to write the real apps/auth/.dev.vars with generated values.
# Never paste a secret into this file: it is committed, and this repo is public.
# Key names and their meaning live in scripts/dev-secrets-manifest.mjs.

# GENERATED: HMAC pepper for API keys and ingest tokens. Read by api, engine, mcp, auth, web and packages/db — a mismatch makes a key minted by one surface unrecognisable to another.
CREDENTIAL_PEPPER=

# GENERATED: Hash-chain key for the tamper-evident audit log. Must match across every surface that appends or verifies.
AUDIT_CHAIN_HMAC_KEY=

# GENERATED: Better Auth signing secret. In auth's REQUIRED_SECRETS — the app throws at the request boundary without it.
BETTER_AUTH_SECRET=

# GENERATED: HMAC key for the OAuth consent ticket.
CONSENT_TICKET_KEY=

# EXTERNAL: Google OAuth dev app with an http://localhost:3001 callback. In REQUIRED_SECRETS today, which is why apps/auth cannot boot locally without real credentials — PR3 makes social login optional in dev.
GOOGLE_CLIENT_ID=

# EXTERNAL: Pairs with GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_SECRET=

# EXTERNAL: GitHub OAuth dev app. See GOOGLE_CLIENT_ID.
GITHUB_CLIENT_ID=

# EXTERNAL: Pairs with GITHUB_CLIENT_ID.
GITHUB_CLIENT_SECRET=

# EXTERNAL: Transactional email. In REQUIRED_SECRETS, so auth hard-fails without it even though web already degrades gracefully — PR3 adds EMAIL_MODE=log so magic links print to the console.
RESEND_API_KEY=

# EXTERNAL: Optional and already degrades correctly: unset means the captcha plugin is not wired. Cloudflare publishes always-pass test keys if you want to exercise the path.
TURNSTILE_SECRET_KEY=
