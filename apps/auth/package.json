{
  "name": "@webhook-co/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "opennextjs-cloudflare build && opennextjs-cloudflare preview -- --test-scheduled --port 3001 --ip 127.0.0.1 --inspector-port 4001",
    "dev:fast": "next dev -p 3001",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:dry": "opennextjs-cloudflare build && wrangler deploy --dry-run",
    "start": "next start",
    "test": "vitest run",
    "test:workers": "vitest run --project workers",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.gen.json && tsc --noEmit -p tsconfig.playwright.json",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --config src/auth.ts --yes --output ../../packages/db/db/migrations/.better-auth.schema.sql"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.25",
    "@cloudflare/workers-oauth-provider": "^0.8.3",
    "@webhook-co/contract": "workspace:*",
    "@webhook-co/db": "workspace:*",
    "@webhook-co/shared": "workspace:*",
    "@webhook-co/ui": "workspace:*",
    "better-auth": "^1.6.25",
    "geist": "^1.7.2",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "pg-cloudflare": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3"
  }
}
